# STRIDE Configuration Template

# App Settings
PROJECT_NAME="STRIDE — Adaptive AI Running Coach"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="stride-super-secret-development-jwt-key-replace-in-production-12345"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database Settings
# For local zero-configuration SQLite:
DATABASE_URL="sqlite+aiosqlite:///./stride.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/stride"

# Strava API Integration (Get from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_WEBHOOK_VERIFY_TOKEN="stride_webhook_verify_token_default"
STRAVA_REDIRECT_URI="http://localhost:3000/strava/callback"

# Frontend URL (for CORS)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
